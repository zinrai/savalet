[Unit]
Description=Savalet HTTP API
Documentation=https://github.com/zinrai/savalet
After=network.target savalet-executor.service
Wants=savalet-executor.service

[Service]
Type=simple
ExecStart=/usr/local/bin/savalet api --config /etc/savalet/api.yaml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s

# Security settings: run as ephemeral user, join the savalet group
# so the API process can connect to the executor's Unix domain socket.
DynamicUser=yes
SupplementaryGroups=savalet
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/savalet

# Resource limits
LimitNOFILE=4096
TasksMax=128

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=savalet-api

[Install]
WantedBy=multi-user.target
