[Unit]
Description=Savalet command execution service
Documentation=https://github.com/zinrai/savalet
Requires=savalet.socket
After=savalet.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/savalet run -config /etc/savalet/savalet.yaml
Restart=on-failure
RestartSec=5s

User=savalet
Group=savalet
# Everything below is inherited by the commands savalet starts, not just
# by savalet itself.
# NoNewPrivileges makes sudo and setuid unusable inside actions. Grant
# privileges through mechanisms that need no escalation, such as polkit.
NoNewPrivileges=true
# An action that writes to the filesystem needs a ReadWritePaths= entry.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/savalet

LimitNOFILE=4096
TasksMax=128

StandardOutput=journal
StandardError=journal
SyslogIdentifier=savalet

[Install]
WantedBy=multi-user.target
